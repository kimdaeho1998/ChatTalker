# Copy locally to .env only for the approved Supabase development database.
APP_ENV=development
APP_NAME=Chatalker API
# Obtain the Session Pooler user from the Supabase dashboard. Never commit a real .env file.
# TLS is enforced by the application, even when this URL omits sslmode.
# DATABASE_URL=postgresql+psycopg://<pooler-user>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# DATABASE_SSLMODE=require
